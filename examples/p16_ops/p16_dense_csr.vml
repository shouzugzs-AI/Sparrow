; P16-2 single-layer proof, generated by tools/p16_sparse_ops.py
; x=[1.5, -2.25, 3, 0.5, -1, 4]  n_neurons=4  k0=2  kept=24 of dense 24

SHAPE off,  5, 1
SHAPE srci, 24, 1
SHAPE wv,   24, 1
SHAPE xv,   6, 1
SHAPE str,  24, 1
SHAPE kk,   1, 1
SHAPE sel,  24, 2
SHAPE y,    5, 1

    COPY off,  offc
    COPY srci, srcc
    COPY wv,   wvc
    COPY xv,   xvc
    COPY kk,   kc
    COPY str,  strc

    ; 1) strength of every connection: s_i = w_i * x_i
    ;    The strengths arrive as a CONSTANT rather than being
    ;    recomputed with EWMUL, for two reasons: (a) s_i needs
    ;    x[src[i]], and the engine has no GATHER (it is on the
    ;    assembler's UNIMPLEMENTED_OPS list -- verified by
    ;    reading asm/src/main.rs, not assumed), so an in-engine
    ;    s_i would need a hand-unrolled gather per row; and
    ;    (b) feeding strengths in directly makes the numeric
    ;    equality attributable to the TOP-K SELECTION alone
    ;    rather than to selection AND a gather.
    ;    The Python reference computes the same products
    ;    independently, so this is not self-confirmation.
    TOPK_BY_STRENGTH sel, str, kk
    ; 2) sparse matvec over the SURVIVING connections only.
    ;    `nnz` makes the engine report the multiply-adds it
    ;    actually performed into y[n_neurons].
    SPARSE_MATVEC y, off, srci, wv, xv, nnz
    HALT
