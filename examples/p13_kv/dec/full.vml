; MiniCPM5-1B full forward (generated by tools/p12_build_minicpm.py)
; S=4 layers=2 hidden=1536 heads=16 kv_heads=2 head_dim=128 inter=4608 vocab=130560
;
; Weights are bf16 and stay bf16: the engine widens them inside the GEMM
; (P12). Widening to f32 on disk would double 2.16 GB to 4.32 GB.
;
; Shapes are declared explicitly because the assembler infers only from
; instruction use, and a wrong width here is a silent misread.

; ---- shapes (activations) ----
SHAPE h,      4, 1536
SHAPE h2,     4, 1536
SHAPE xn,     4, 1536
SHAPE q,      4, 2048
SHAPE k,      4, 256
SHAPE v,      4, 256
SHAPE qh,     4, 128
SHAPE kh,     4, 128
SHAPE vh,     4, 128
SHAPE qrot,   4, 128
SHAPE krot,   4, 128
SHAPE sc,     4, 4
SHAPE ctx,    4, 128
SHAPE att,    4, 2048
SHAPE oproj,  4, 1536
SHAPE gate,   4, 4608
SHAPE up,     4, 4608
SHAPE acts,   4, 4608
SHAPE down,   4, 1536
SHAPE tail,   4, 8
SHAPE eps1,   1, 1
SHAPE theta1, 1, 1
SHAPE scale1, 1, 1

; ---- embedding lookup: h = embed[tokens]  (P13 task A) ----
; THE POINT OF THIS MODE: the program carries NO prompt data.
; Token ids are read from `tokens.bin` by the runtime into the
; `st_tok` state slot, then EMB widens one row per token.
; ONE .vmb therefore serves ANY prompt -- changing the prompt is a
; 16-byte file write instead of a 1.76 GB reassembly (~106 s).
;
; `st_tok` is a state slot (the `st_` prefix); state is engine-owned
; and persists, and the runtime fills it before run().
;
; Its shape MUST be declared: an undeclared slot has capacity 0, and
; the runtime then hard-fails with 'tokens.bin is longer than the
; st_tok slot' (measured -- that guard is what caught this). [1,S]
; because the runtime fills it with S token ids, one per element.
SHAPE st_tok, 1, 4
;
; EMB reads its row index from a SINGLE scalar slot, so one lookup is
; needed per token position. Rows are then stacked with CONCAT, which
; concatenates along COLUMNS -- so we transpose the problem: look up
; the token's row as [1,H], and build h by concatenating the S rows
; side by side into [1, S*H], then RESHAPE-equivalent via SHAPE.
; Simpler and exact: build a [S,H] h by concatenating single-row
; slices, so the intermediate is [1,H] and CONCAT gives [1,S*H].
; That layout is (token-major), i.e. element (i, j) sits at i*H + j,
; which IS row-major [S,H]. So h = the concatenated buffer.
;   row 0 = embed[tok[0]]
SLICE tok0, st_tok, 0, 1
SHAPE e0, 1, 1536
EMB e0, embed, tok0
;   row 1 = embed[tok[1]]
SLICE tok1, st_tok, 1, 1
SHAPE e1, 1, 1536
EMB e1, embed, tok1
;   row 2 = embed[tok[2]]
SLICE tok2, st_tok, 2, 1
SHAPE e2, 1, 1536
EMB e2, embed, tok2
;   row 3 = embed[tok[3]]
SLICE tok3, st_tok, 3, 1
SHAPE e3, 1, 1536
EMB e3, embed, tok3
SHAPE hcat0, 1, 1536
COPY hcat0, e0
SHAPE hcat1, 1, 3072
CONCAT hcat1, hcat0, e1
SHAPE hcat2, 1, 4608
CONCAT hcat2, hcat1, e2
SHAPE hcat3, 1, 6144
CONCAT hcat3, hcat2, e3
SHAPE hflat, 4, 1536
COPY hflat, hcat3
COPY h, hflat

; ---- P13 task C: KV cache in STATE slots (transposed [HD, PMAX]) ----
; STATE, not activation: state persists and is engine-owned. The
; transposed layout makes appending position p a COLUMN write, so
; TRANSPOSE + WRITECOL suffice -- no new engine opcode.
;
; ONE CACHE PER KV HEAD, not one per layer. Why (this was a real bug):
; a single [NKV*HD, PMAX] cache stores kv head j in ROWS j*HD..j*HD+HD.
; Selecting those rows needs a ROW slice, but OP_SLICE indexes COLUMNS
; (dst[i][j] = src[i][off+j]), so head j was unreachable -- every query
; head read kv head 0. Measured symptom: prefill matched the reference
; EXACTLY (0.0) while every decode step was off by ~80 on values of
; magnitude ~80, i.e. structurally wrong rather than drifting.
; Per-head caches remove the row arithmetic entirely: head j reads
; st_kc{j} directly, and the read slice is a plain COLUMN range.
SHAPE st_kc0_0, 128, 6
SHAPE st_vc0_0, 128, 6
SHAPE st_kc0_1, 128, 6
SHAPE st_vc0_1, 128, 6
SHAPE st_kc1_0, 128, 6
SHAPE st_vc1_0, 128, 6
SHAPE st_kc1_1, 128, 6
SHAPE st_vc1_1, 128, 6
SHAPE st_gen, 1, 2
SHAPE kdT, 128, 1
SHAPE vdT, 128, 1
SHAPE hdec, 1, 1536
SHAPE eh, 1, 1536
SHAPE attd, 1, 2048
SHAPE qd, 1, 2048
SHAPE kd, 1, 256
SHAPE vd, 1, 256
SHAPE qdh, 1, 128
SHAPE kdh, 1, 128
SHAPE vdh, 1, 128
SHAPE qdrot, 1, 128
SHAPE kdrot, 1, 128
SHAPE h2d, 1, 1536
SHAPE oprojd, 1, 1536
SHAPE gated, 1, 4608
SHAPE upd, 1, 4608
SHAPE actsd, 1, 4608
SHAPE downd, 1, 1536
SHAPE xnd, 1, 1536
SHAPE krow, 1, 128
SHAPE vrow, 1, 128
SHAPE knewT, 128, 1
SHAPE vnewT, 128, 1
SHAPE kcraw, 4, 128
SHAPE kcrot, 4, 128
SHAPE vcraw, 4, 128
SHAPE kcrotT, 128, 4
SHAPE vcrawT, 128, 4
SHAPE kcol, 128, 1
SHAPE vcol, 128, 1
SHAPE gtok, 1, 1

; ================= layer 0 =================
RMSNORM xn, h, L0_in_ln, eps1
GEMM q, xn, L0_q
GEMM k, xn, L0_k
GEMM v, xn, L0_v
SLICE qh, q, 0, 128
SLICE kh, k, 0, 128
SLICE vh, v, 0, 128
ROPE qrot, qh, theta1, 0
ROPE krot, kh, theta1, 0
GEMM sc, qrot, krot
SCALE sc, sc, scale1
SOFTMAX sc, sc, causal
GEMM ctx, sc, vh, nn
WRITECOL att, ctx, 0, 128
SLICE qh, q, 128, 128
SLICE kh, k, 0, 128
SLICE vh, v, 0, 128
ROPE qrot, qh, theta1, 0
ROPE krot, kh, theta1, 0
GEMM sc, qrot, krot
SCALE sc, sc, scale1
SOFTMAX sc, sc, causal
GEMM ctx, sc, vh, nn
WRITECOL att, ctx, 128, 128
SLICE qh, q, 256, 128
SLICE kh, k, 0, 128
SLICE vh, v, 0, 128
ROPE qrot, qh, theta1, 0
ROPE krot, kh, theta1, 0
GEMM sc, qrot, krot
SCALE sc, sc, scale1
SOFTMAX sc, sc, causal
GEMM ctx, sc, vh, nn
WRITECOL att, ctx, 256, 128
SLICE qh, q, 384, 128
SLICE kh, k, 0, 128
SLICE vh, v, 0, 128
ROPE qrot, qh, theta1, 0
ROPE krot, kh, theta1, 0
GEMM sc, qrot, krot
SCALE sc, sc, scale1
SOFTMAX sc, sc, causal
GEMM ctx, sc, vh, nn
WRITECOL att, ctx, 384, 128
SLICE qh, q, 512, 128
SLICE kh, k, 0, 128
SLICE vh, v, 0, 128
ROPE qrot, qh, theta1, 0
ROPE krot, kh, theta1, 0
GEMM sc, qrot, krot
SCALE sc, sc, scale1
SOFTMAX sc, sc, causal
GEMM ctx, sc, vh, nn
WRITECOL att, ctx, 512, 128
SLICE qh, q, 640, 128
SLICE kh, k, 0, 128
SLICE vh, v, 0, 128
ROPE qrot, qh, theta1, 0
ROPE krot, kh, theta1, 0
GEMM sc, qrot, krot
SCALE sc, sc, scale1
SOFTMAX sc, sc, causal
GEMM ctx, sc, vh, nn
WRITECOL att, ctx, 640, 128
SLICE qh, q, 768, 128
SLICE kh, k, 0, 128
SLICE vh, v, 0, 128
ROPE qrot, qh, theta1, 0
ROPE krot, kh, theta1, 0
GEMM sc, qrot, krot
SCALE sc, sc, scale1
SOFTMAX sc, sc, causal
GEMM ctx, sc, vh, nn
WRITECOL att, ctx, 768, 128
SLICE qh, q, 896, 128
SLICE kh, k, 0, 128
SLICE vh, v, 0, 128
ROPE qrot, qh, theta1, 0
ROPE krot, kh, theta1, 0
GEMM sc, qrot, krot
SCALE sc, sc, scale1
SOFTMAX sc, sc, causal
GEMM ctx, sc, vh, nn
WRITECOL att, ctx, 896, 128
SLICE qh, q, 1024, 128
SLICE kh, k, 128, 128
SLICE vh, v, 128, 128
ROPE qrot, qh, theta1, 0
ROPE krot, kh, theta1, 0
GEMM sc, qrot, krot
SCALE sc, sc, scale1
SOFTMAX sc, sc, causal
GEMM ctx, sc, vh, nn
WRITECOL att, ctx, 1024, 128
SLICE qh, q, 1152, 128
SLICE kh, k, 128, 128
SLICE vh, v, 128, 128
ROPE qrot, qh, theta1, 0
ROPE krot, kh, theta1, 0
GEMM sc, qrot, krot
SCALE sc, sc, scale1
SOFTMAX sc, sc, causal
GEMM ctx, sc, vh, nn
WRITECOL att, ctx, 1152, 128
SLICE qh, q, 1280, 128
SLICE kh, k, 128, 128
SLICE vh, v, 128, 128
ROPE qrot, qh, theta1, 0
ROPE krot, kh, theta1, 0
GEMM sc, qrot, krot
SCALE sc, sc, scale1
SOFTMAX sc, sc, causal
GEMM ctx, sc, vh, nn
WRITECOL att, ctx, 1280, 128
SLICE qh, q, 1408, 128
SLICE kh, k, 128, 128
SLICE vh, v, 128, 128
ROPE qrot, qh, theta1, 0
ROPE krot, kh, theta1, 0
GEMM sc, qrot, krot
SCALE sc, sc, scale1
SOFTMAX sc, sc, causal
GEMM ctx, sc, vh, nn
WRITECOL att, ctx, 1408, 128
SLICE qh, q, 1536, 128
SLICE kh, k, 128, 128
SLICE vh, v, 128, 128
ROPE qrot, qh, theta1, 0
ROPE krot, kh, theta1, 0
GEMM sc, qrot, krot
SCALE sc, sc, scale1
SOFTMAX sc, sc, causal
GEMM ctx, sc, vh, nn
WRITECOL att, ctx, 1536, 128
SLICE qh, q, 1664, 128
SLICE kh, k, 128, 128
SLICE vh, v, 128, 128
ROPE qrot, qh, theta1, 0
ROPE krot, kh, theta1, 0
GEMM sc, qrot, krot
SCALE sc, sc, scale1
SOFTMAX sc, sc, causal
GEMM ctx, sc, vh, nn
WRITECOL att, ctx, 1664, 128
SLICE qh, q, 1792, 128
SLICE kh, k, 128, 128
SLICE vh, v, 128, 128
ROPE qrot, qh, theta1, 0
ROPE krot, kh, theta1, 0
GEMM sc, qrot, krot
SCALE sc, sc, scale1
SOFTMAX sc, sc, causal
GEMM ctx, sc, vh, nn
WRITECOL att, ctx, 1792, 128
SLICE qh, q, 1920, 128
SLICE kh, k, 128, 128
SLICE vh, v, 128, 128
ROPE qrot, qh, theta1, 0
ROPE krot, kh, theta1, 0
GEMM sc, qrot, krot
SCALE sc, sc, scale1
SOFTMAX sc, sc, causal
GEMM ctx, sc, vh, nn
WRITECOL att, ctx, 1920, 128
GEMM oproj, att, L0_o
EWADD h2, h, oproj
RMSNORM xn, h2, L0_post_ln, eps1
GEMM gate, xn, L0_gate
GEMM up, xn, L0_up
ACT acts, gate, silu
EWMUL acts, acts, up
GEMM down, acts, L0_down
EWADD h, h2, down
;   cache K (ROTATED) and V for the 4 prompt positions, layer 0
SLICE kcraw, k, 0, 128
ROPE kcrot, kcraw, theta1, 0
SLICE vcraw, v, 0, 128
TRANSPOSE kcrotT, kcrot
TRANSPOSE vcrawT, vcraw
SLICE kcol, kcrotT, 0, 1
WRITECOL st_kc0_0, kcol, 0
SLICE vcol, vcrawT, 0, 1
WRITECOL st_vc0_0, vcol, 0
SLICE kcol, kcrotT, 1, 1
WRITECOL st_kc0_0, kcol, 1
SLICE vcol, vcrawT, 1, 1
WRITECOL st_vc0_0, vcol, 1
SLICE kcol, kcrotT, 2, 1
WRITECOL st_kc0_0, kcol, 2
SLICE vcol, vcrawT, 2, 1
WRITECOL st_vc0_0, vcol, 2
SLICE kcol, kcrotT, 3, 1
WRITECOL st_kc0_0, kcol, 3
SLICE vcol, vcrawT, 3, 1
WRITECOL st_vc0_0, vcol, 3
SLICE kcraw, k, 128, 128
ROPE kcrot, kcraw, theta1, 0
SLICE vcraw, v, 128, 128
TRANSPOSE kcrotT, kcrot
TRANSPOSE vcrawT, vcraw
SLICE kcol, kcrotT, 0, 1
WRITECOL st_kc0_1, kcol, 0
SLICE vcol, vcrawT, 0, 1
WRITECOL st_vc0_1, vcol, 0
SLICE kcol, kcrotT, 1, 1
WRITECOL st_kc0_1, kcol, 1
SLICE vcol, vcrawT, 1, 1
WRITECOL st_vc0_1, vcol, 1
SLICE kcol, kcrotT, 2, 1
WRITECOL st_kc0_1, kcol, 2
SLICE vcol, vcrawT, 2, 1
WRITECOL st_vc0_1, vcol, 2
SLICE kcol, kcrotT, 3, 1
WRITECOL st_kc0_1, kcol, 3
SLICE vcol, vcrawT, 3, 1
WRITECOL st_vc0_1, vcol, 3

; ================= layer 1 =================
RMSNORM xn, h, L1_in_ln, eps1
GEMM q, xn, L1_q
GEMM k, xn, L1_k
GEMM v, xn, L1_v
SLICE qh, q, 0, 128
SLICE kh, k, 0, 128
SLICE vh, v, 0, 128
ROPE qrot, qh, theta1, 0
ROPE krot, kh, theta1, 0
GEMM sc, qrot, krot
SCALE sc, sc, scale1
SOFTMAX sc, sc, causal
GEMM ctx, sc, vh, nn
WRITECOL att, ctx, 0, 128
SLICE qh, q, 128, 128
SLICE kh, k, 0, 128
SLICE vh, v, 0, 128
ROPE qrot, qh, theta1, 0
ROPE krot, kh, theta1, 0
GEMM sc, qrot, krot
SCALE sc, sc, scale1
SOFTMAX sc, sc, causal
GEMM ctx, sc, vh, nn
WRITECOL att, ctx, 128, 128
SLICE qh, q, 256, 128
SLICE kh, k, 0, 128
SLICE vh, v, 0, 128
ROPE qrot, qh, theta1, 0
ROPE krot, kh, theta1, 0
GEMM sc, qrot, krot
SCALE sc, sc, scale1
SOFTMAX sc, sc, causal
GEMM ctx, sc, vh, nn
WRITECOL att, ctx, 256, 128
SLICE qh, q, 384, 128
SLICE kh, k, 0, 128
SLICE vh, v, 0, 128
ROPE qrot, qh, theta1, 0
ROPE krot, kh, theta1, 0
GEMM sc, qrot, krot
SCALE sc, sc, scale1
SOFTMAX sc, sc, causal
GEMM ctx, sc, vh, nn
WRITECOL att, ctx, 384, 128
SLICE qh, q, 512, 128
SLICE kh, k, 0, 128
SLICE vh, v, 0, 128
ROPE qrot, qh, theta1, 0
ROPE krot, kh, theta1, 0
GEMM sc, qrot, krot
SCALE sc, sc, scale1
SOFTMAX sc, sc, causal
GEMM ctx, sc, vh, nn
WRITECOL att, ctx, 512, 128
SLICE qh, q, 640, 128
SLICE kh, k, 0, 128
SLICE vh, v, 0, 128
ROPE qrot, qh, theta1, 0
ROPE krot, kh, theta1, 0
GEMM sc, qrot, krot
SCALE sc, sc, scale1
SOFTMAX sc, sc, causal
GEMM ctx, sc, vh, nn
WRITECOL att, ctx, 640, 128
SLICE qh, q, 768, 128
SLICE kh, k, 0, 128
SLICE vh, v, 0, 128
ROPE qrot, qh, theta1, 0
ROPE krot, kh, theta1, 0
GEMM sc, qrot, krot
SCALE sc, sc, scale1
SOFTMAX sc, sc, causal
GEMM ctx, sc, vh, nn
WRITECOL att, ctx, 768, 128
SLICE qh, q, 896, 128
SLICE kh, k, 0, 128
SLICE vh, v, 0, 128
ROPE qrot, qh, theta1, 0
ROPE krot, kh, theta1, 0
GEMM sc, qrot, krot
SCALE sc, sc, scale1
SOFTMAX sc, sc, causal
GEMM ctx, sc, vh, nn
WRITECOL att, ctx, 896, 128
SLICE qh, q, 1024, 128
SLICE kh, k, 128, 128
SLICE vh, v, 128, 128
ROPE qrot, qh, theta1, 0
ROPE krot, kh, theta1, 0
GEMM sc, qrot, krot
SCALE sc, sc, scale1
SOFTMAX sc, sc, causal
GEMM ctx, sc, vh, nn
WRITECOL att, ctx, 1024, 128
SLICE qh, q, 1152, 128
SLICE kh, k, 128, 128
SLICE vh, v, 128, 128
ROPE qrot, qh, theta1, 0
ROPE krot, kh, theta1, 0
GEMM sc, qrot, krot
SCALE sc, sc, scale1
SOFTMAX sc, sc, causal
GEMM ctx, sc, vh, nn
WRITECOL att, ctx, 1152, 128
SLICE qh, q, 1280, 128
SLICE kh, k, 128, 128
SLICE vh, v, 128, 128
ROPE qrot, qh, theta1, 0
ROPE krot, kh, theta1, 0
GEMM sc, qrot, krot
SCALE sc, sc, scale1
SOFTMAX sc, sc, causal
GEMM ctx, sc, vh, nn
WRITECOL att, ctx, 1280, 128
SLICE qh, q, 1408, 128
SLICE kh, k, 128, 128
SLICE vh, v, 128, 128
ROPE qrot, qh, theta1, 0
ROPE krot, kh, theta1, 0
GEMM sc, qrot, krot
SCALE sc, sc, scale1
SOFTMAX sc, sc, causal
GEMM ctx, sc, vh, nn
WRITECOL att, ctx, 1408, 128
SLICE qh, q, 1536, 128
SLICE kh, k, 128, 128
SLICE vh, v, 128, 128
ROPE qrot, qh, theta1, 0
ROPE krot, kh, theta1, 0
GEMM sc, qrot, krot
SCALE sc, sc, scale1
SOFTMAX sc, sc, causal
GEMM ctx, sc, vh, nn
WRITECOL att, ctx, 1536, 128
SLICE qh, q, 1664, 128
SLICE kh, k, 128, 128
SLICE vh, v, 128, 128
ROPE qrot, qh, theta1, 0
ROPE krot, kh, theta1, 0
GEMM sc, qrot, krot
SCALE sc, sc, scale1
SOFTMAX sc, sc, causal
GEMM ctx, sc, vh, nn
WRITECOL att, ctx, 1664, 128
SLICE qh, q, 1792, 128
SLICE kh, k, 128, 128
SLICE vh, v, 128, 128
ROPE qrot, qh, theta1, 0
ROPE krot, kh, theta1, 0
GEMM sc, qrot, krot
SCALE sc, sc, scale1
SOFTMAX sc, sc, causal
GEMM ctx, sc, vh, nn
WRITECOL att, ctx, 1792, 128
SLICE qh, q, 1920, 128
SLICE kh, k, 128, 128
SLICE vh, v, 128, 128
ROPE qrot, qh, theta1, 0
ROPE krot, kh, theta1, 0
GEMM sc, qrot, krot
SCALE sc, sc, scale1
SOFTMAX sc, sc, causal
GEMM ctx, sc, vh, nn
WRITECOL att, ctx, 1920, 128
GEMM oproj, att, L1_o
EWADD h2, h, oproj
RMSNORM xn, h2, L1_post_ln, eps1
GEMM gate, xn, L1_gate
GEMM up, xn, L1_up
ACT acts, gate, silu
EWMUL acts, acts, up
GEMM down, acts, L1_down
EWADD h, h2, down
;   cache K (ROTATED) and V for the 4 prompt positions, layer 1
SLICE kcraw, k, 0, 128
ROPE kcrot, kcraw, theta1, 0
SLICE vcraw, v, 0, 128
TRANSPOSE kcrotT, kcrot
TRANSPOSE vcrawT, vcraw
SLICE kcol, kcrotT, 0, 1
WRITECOL st_kc1_0, kcol, 0
SLICE vcol, vcrawT, 0, 1
WRITECOL st_vc1_0, vcol, 0
SLICE kcol, kcrotT, 1, 1
WRITECOL st_kc1_0, kcol, 1
SLICE vcol, vcrawT, 1, 1
WRITECOL st_vc1_0, vcol, 1
SLICE kcol, kcrotT, 2, 1
WRITECOL st_kc1_0, kcol, 2
SLICE vcol, vcrawT, 2, 1
WRITECOL st_vc1_0, vcol, 2
SLICE kcol, kcrotT, 3, 1
WRITECOL st_kc1_0, kcol, 3
SLICE vcol, vcrawT, 3, 1
WRITECOL st_vc1_0, vcol, 3
SLICE kcraw, k, 128, 128
ROPE kcrot, kcraw, theta1, 0
SLICE vcraw, v, 128, 128
TRANSPOSE kcrotT, kcrot
TRANSPOSE vcrawT, vcraw
SLICE kcol, kcrotT, 0, 1
WRITECOL st_kc1_1, kcol, 0
SLICE vcol, vcrawT, 0, 1
WRITECOL st_vc1_1, vcol, 0
SLICE kcol, kcrotT, 1, 1
WRITECOL st_kc1_1, kcol, 1
SLICE vcol, vcrawT, 1, 1
WRITECOL st_vc1_1, vcol, 1
SLICE kcol, kcrotT, 2, 1
WRITECOL st_kc1_1, kcol, 2
SLICE vcol, vcrawT, 2, 1
WRITECOL st_vc1_1, vcol, 2
SLICE kcol, kcrotT, 3, 1
WRITECOL st_kc1_1, kcol, 3
SLICE vcol, vcrawT, 3, 1
WRITECOL st_vc1_1, vcol, 3

; ---- final norm ----
RMSNORM xn, h, final_norm, eps1
PRINT xn

; ================ P13 task C: incremental decode ================
; 2 steps after a 4-token prefill; each step is one token.

; ---- decode step 0 (absolute position 4) ----
SHAPE kcv0, 128, 5
SHAPE vcv0, 128, 5
SHAPE scd0, 1, 5
SHAPE ctxd0, 1, 128
; h = embed[token]  (one row)
SLICE gtok, st_gen, 0, 1
EMB eh, embed, gtok
COPY hdec, eh

;   layer 0
RMSNORM xnd, hdec, L0_in_ln, eps1
GEMM qd, xnd, L0_q
GEMM kd, xnd, L0_k
GEMM vd, xnd, L0_v
SLICE kdh, kd, 0, 128
SLICE vdh, vd, 0, 128
ROPE kdrot, kdh, theta1, 4
TRANSPOSE kdT, kdrot
TRANSPOSE vdT, vdh
WRITECOL st_kc0_0, kdT, 4
WRITECOL st_vc0_0, vdT, 4
SLICE kdh, kd, 128, 128
SLICE vdh, vd, 128, 128
ROPE kdrot, kdh, theta1, 4
TRANSPOSE kdT, kdrot
TRANSPOSE vdT, vdh
WRITECOL st_kc0_1, kdT, 4
WRITECOL st_vc0_1, vdT, 4
SLICE qdh, qd, 0, 128
ROPE qdrot, qdh, theta1, 4
SLICE kcv0, st_kc0_0, 0, 5
SLICE vcv0, st_vc0_0, 0, 5
GEMM scd0, qdrot, kcv0, nn
SCALE scd0, scd0, scale1
SOFTMAX scd0, scd0
GEMM ctxd0, scd0, vcv0
WRITECOL attd, ctxd0, 0, 128
SLICE qdh, qd, 128, 128
ROPE qdrot, qdh, theta1, 4
SLICE kcv0, st_kc0_0, 0, 5
