; ============================================================================
; A2 / P8: ESERNN BPTT training step
; *** GENERATED by gen_bptt.py -- do not hand-edit ***
;
; config: T=2  H=16  D=8  V=4
; regenerate: python gen_bptt.py 2 16 8 4
;
; Forward math follows examples/rnn/ese_step.vml; the backward style follows
; examples/mnist/train_step.vml. BPTT uses the P8 STACK_INIT/PUSH/POP ops:
; activation slots are a single shared buffer overwritten each step, so every
; quantity the backward pass needs is PUSHed during the forward and POPped
; back in reverse step order.
;
; Operator semantics (verified against core/src/interp.rs, core/src/autograd.rs):
;   GEMM        default NT: C[M,N] = A[M,K] * B[N,K]^T
;   LN          4 operands: LN dst, src, gamma, bias
;   LN_BWD      dst=dx, dy, x, dg ; db is the slot right after dg
;               (dg/db ACCUMULATE, dx is OVERWRITTEN)
;   ACT_BWD     dst=dx, dy, ypre, kind
;   OUTER       S[i,j] += v[i]*k[j]
;   OUTER_BWD   dst=dv, ds, v, dk (dv OVERWRITES, dk ACCUMULATES)
;   GEMM_BWD_W  dW += dy^T x   (accumulates)
;   GEMM_BWD_X  dx  = dy W     (overwrites)
;   BIAS_BWD    db += sum_i dy[i] (accumulates)
;   PUSH/POP/STACK_INIT: 3rd operand is a numeric step index
; ============================================================================

; Weights and inputs are injected by the assembler on the command line as
;   name:file.bin:rows:cols      (f32 little-endian, relative path)
; See weights.args in this directory, generated alongside this file.

.section state
    SHAPE       st_S,     8, 8     ; recurrent state S[D,D], persists across steps
    SHAPE       st_hprev, 1, 16    ; h from the previous step

.section forward
    ; ---------- per-step working slots ----------
    SHAPE       ln1_g, 1, 16
    SHAPE       g_ln1_g, 1, 16
    SHAPE       g_ln1_b, 1, 16
    SHAPE       ln_t_g, 1, 8
    SHAPE       g_ln_t_g, 1, 8
    SHAPE       g_ln_t_b, 1, 8
    SHAPE       ln_out_g, 1, 16
    SHAPE       g_ln_out_g, 1, 16
    SHAPE       g_ln_out_b, 1, 16

    SHAPE       x_cur, 1, 16
    SHAPE       u, 1, 16
    SHAPE       d, 1, 16
    SHAPE       g32, 1, 16
    SHAPE       dtimesx, 1, 16
    SHAPE       rpre, 1, 8
    SHAPE       r, 1, 8
    SHAPE       k, 1, 8
    SHAPE       v, 1, 8
    SHAPE       gdpre, 1, 32
    SHAPE       gdact, 1, 32
    SHAPE       om, 1, 8
    SHAPE       expom, 1, 8
    SHAPE       decay, 1, 8
    SHAPE       decayCol, 8, 1
    SHAPE       oCol, 8, 1
    SHAPE       oRow, 1, 8
    SHAPE       woCol, 16, 1
    SHAPE       hpCol, 16, 1
    SHAPE       hCol, 16, 1
    SHAPE       h, 1, 16
    SHAPE       hNorm, 1, 16
    SHAPE       sr, 1, 8
    SHAPE       logits0, 1, 4
    SHAPE       logits1, 1, 4
    SHAPE       dtx_r, 1, 16
    SHAPE       gr, 1, 16
    SHAPE       dtx_k, 1, 16
    SHAPE       gk, 1, 16
    SHAPE       dtx_v, 1, 16
    SHAPE       gv, 1, 16

    ; ---------- BPTT stacks: [T, elements-per-step] ----------
    SHAPE       stk_xt, 2, 16
    SHAPE       stk_d, 2, 16
    SHAPE       stk_hprev, 2, 16
    SHAPE       stk_Sprev, 2, 64
    SHAPE       stk_Scur, 2, 64
    SHAPE       stk_v, 2, 8
    SHAPE       stk_k, 2, 8
    SHAPE       stk_r, 2, 8
    SHAPE       stk_rpre, 2, 8
    SHAPE       stk_gpr, 2, 16
    SHAPE       stk_gpk, 2, 16
    SHAPE       stk_gpv, 2, 16
    SHAPE       stk_gdpre, 2, 32
    SHAPE       stk_gdact, 2, 32
    SHAPE       stk_gpw, 2, 16
    SHAPE       stk_expom, 2, 8
    SHAPE       stk_decay, 2, 8
    SHAPE       stk_oRow, 2, 8
    SHAPE       stk_sr_t, 2, 8
    SHAPE       stk_h, 2, 16
    SHAPE       stk_hNorm, 2, 16

    ; ---------- backward working slots ----------
    SHAPE       dh, 1, 16
    SHAPE       dhAdd, 1, 16
    SHAPE       dhNorm, 1, 16
    SHAPE       doRow, 1, 8
    SHAPE       dlnoRow, 1, 8
    SHAPE       dlnoCol, 8, 1
    SHAPE       dS, 8, 8
    SHAPE       dSprev, 8, 8
    SHAPE       dSwork, 8, 8
    SHAPE       dSworkT, 8, 8
    SHAPE       S_tT, 8, 8
    SHAPE       ddecay, 1, 8
    SHAPE       dom, 1, 8
    SHAPE       ddom, 1, 8
    SHAPE       dv, 1, 8
    SHAPE       drRow, 1, 8
    SHAPE       drpre, 1, 8
    SHAPE       dgr, 1, 16
    SHAPE       dgk, 1, 16
    SHAPE       dgv, 1, 16
    SHAPE       dgdact, 1, 32
    SHAPE       dgdpre, 1, 32
    SHAPE       dg32w, 1, 16
    SHAPE       tmpXw, 1, 16
    SHAPE       tmpDw, 1, 16
    SHAPE       tmpXr, 1, 16
    SHAPE       tmpDr, 1, 16
    SHAPE       tmpXk, 1, 16
    SHAPE       tmpDk, 1, 16
    SHAPE       tmpXv, 1, 16
    SHAPE       tmpDv, 1, 16
    SHAPE       dU, 1, 16
    SHAPE       dUtot, 1, 16
    SHAPE       dDtot, 1, 16
    SHAPE       dDneg, 1, 16
    SHAPE       dxln, 1, 16
    SHAPE       dlogits, 1, 4
    SHAPE       loss_out0, 1, 4
    SHAPE       loss_out1, 1, 4
    SHAPE       k_t, 1, 8
    SHAPE       dkAcc, 1, 8
    SHAPE       dkAccT, 1, 8
    SHAPE       h_t, 1, 16
    SHAPE       sr_t, 1, 8
    SHAPE       r_t, 1, 8
    SHAPE       S_t, 8, 8
    SHAPE       v_t, 1, 8
    SHAPE       decay_t, 1, 8
    SHAPE       S_prev, 8, 8
    SHAPE       expom_t, 1, 8
    SHAPE       gdact_t, 1, 32
    SHAPE       gdpre_t, 1, 32
    SHAPE       gpw_t, 1, 16
    SHAPE       d_t, 1, 16
    SHAPE       rpre_t, 1, 8
    SHAPE       gpr_t, 1, 16
    SHAPE       gpk_t, 1, 16
    SHAPE       gpv_t, 1, 16
    SHAPE       x_t, 1, 16

    LN_EPS      eps1e6

    ; ---------- zero gradients ----------
    ZERO        g_W_r
    ZERO        g_W_k
    ZERO        g_W_v
    ZERO        g_W_o
    ZERO        g_W1d
    ZERO        g_W2d
    ZERO        g_w0
    ZERO        g_xr
    ZERO        g_xk
    ZERO        g_xv
    ZERO        g_xw
    ZERO        g_ln1_g
    ZERO        g_ln1_b
    ZERO        g_ln_t_g
    ZERO        g_ln_t_b
    ZERO        g_ln_out_g
    ZERO        g_ln_out_b
    ZERO        g_E

    ; ---------- reset stacks and state (a train step is self-contained) ----------
    STACK_INIT  stk_xt, 2
    STACK_INIT  stk_d, 2
    STACK_INIT  stk_hprev, 2
    STACK_INIT  stk_Sprev, 2
    STACK_INIT  stk_Scur, 2
    STACK_INIT  stk_v, 2
    STACK_INIT  stk_k, 2
    STACK_INIT  stk_r, 2
    STACK_INIT  stk_rpre, 2
    STACK_INIT  stk_gpr, 2
    STACK_INIT  stk_gpk, 2
    STACK_INIT  stk_gpv, 2
    STACK_INIT  stk_gdpre, 2
    STACK_INIT  stk_gdact, 2
    STACK_INIT  stk_gpw, 2
    STACK_INIT  stk_expom, 2
    STACK_INIT  stk_decay, 2
    STACK_INIT  stk_oRow, 2
    STACK_INIT  stk_sr_t, 2
    STACK_INIT  stk_h, 2
    STACK_INIT  stk_hNorm, 2
    ZERO        st_S
    ZERO        st_hprev

    ; ================================================================
    ;  FORWARD step 0
    ; ================================================================
    COPY        x_cur, x0
    LN          u, x_cur, ln1_g, ln1_b
    EWSUB       d, st_hprev, u
    PUSH        stk_xt,       x_cur,    0
    PUSH        stk_d,        d,        0
    PUSH        stk_hprev,    st_hprev, 0
    PUSH        stk_Sprev,    st_S,     0

    ; r = sigmoid(W_r (u + d*xr))
    EWMUL       dtx_r, d, xr
    EWADD       gr, u, dtx_r
    PUSH        stk_gpr, gr, 0
    GEMM        rpre, gr, W_r
    PUSH        stk_rpre, rpre, 0
    ACT         r, rpre, sigmoid
    PUSH        stk_r, r, 0

    ; k = W_k (u + d*xk)
    EWMUL       dtx_k, d, xk
    EWADD       gk, u, dtx_k
    PUSH        stk_gpk, gk, 0
    GEMM        k, gk, W_k
    PUSH        stk_k, k, 0

    ; v = W_v (u + d*xv)
    EWMUL       dtx_v, d, xv
    EWADD       gv, u, dtx_v
    PUSH        stk_gpv, gv, 0
    GEMM        v, gv, W_v
    PUSH        stk_v, v, 0

    ; decay = exp(-exp(W2d tanh(W1d (u + d*xw)) + w0))
    EWMUL       dtimesx, d, xw
    EWADD       g32, u, dtimesx
    PUSH        stk_gpw, g32, 0
    GEMM        gdpre, g32, W1d
    PUSH        stk_gdpre, gdpre, 0
    COPY        gdact, gdpre
    ACT         gdact, gdact, tanh
    PUSH        stk_gdact, gdact, 0
    GEMM        om, gdact, W2d
    EWADD       om, om, w0
    EXP         expom, om
    PUSH        stk_expom, expom, 0
    NEG         expom, expom
    EXP         decay, expom
    PUSH        stk_decay, decay, 0

    ; S_t = S_{t-1} * decay + v outer k   (decay scales the row index i)
    TRANSPOSE   decayCol, decay
    EWMUL       st_S, st_S, decayCol
    OUTER       st_S, v, k
    PUSH        stk_Scur, st_S, 0

    ; o = LN_t(S r) ; keep S r for the LN_t backward
    GEMM        oCol, st_S, r
    TRANSPOSE   oRow, oCol
    COPY        sr, oRow
    PUSH        stk_sr_t, sr, 0
    LN          oRow, oRow, ln_t_g, ln_t_b
    PUSH        stk_oRow, oRow, 0

    ; h_t = h_{t-1} + W_o o
    GEMM        woCol, W_o, oRow
    TRANSPOSE   hpCol, st_hprev
    EWADD       hCol, hpCol, woCol
    TRANSPOSE   h, hCol
    COPY        st_hprev, h
    PUSH        stk_h, h, 0

    ; logits = LN_out(h) E^T
    LN          hNorm, h, ln_out_g, ln_out_b
    PUSH        stk_hNorm, hNorm, 0
    GEMM        logits0, hNorm, E

    ; ================================================================
    ;  FORWARD step 1
    ; ================================================================
    COPY        x_cur, x1
    LN          u, x_cur, ln1_g, ln1_b
    EWSUB       d, st_hprev, u
    PUSH        stk_xt,       x_cur,    1
    PUSH        stk_d,        d,        1
    PUSH        stk_hprev,    st_hprev, 1
    PUSH        stk_Sprev,    st_S,     1

    ; r = sigmoid(W_r (u + d*xr))
    EWMUL       dtx_r, d, xr
    EWADD       gr, u, dtx_r
    PUSH        stk_gpr, gr, 1
    GEMM        rpre, gr, W_r
    PUSH        stk_rpre, rpre, 1
    ACT         r, rpre, sigmoid
    PUSH        stk_r, r, 1

    ; k = W_k (u + d*xk)
    EWMUL       dtx_k, d, xk
    EWADD       gk, u, dtx_k
    PUSH        stk_gpk, gk, 1
    GEMM        k, gk, W_k
    PUSH        stk_k, k, 1

    ; v = W_v (u + d*xv)
    EWMUL       dtx_v, d, xv
    EWADD       gv, u, dtx_v
    PUSH        stk_gpv, gv, 1
    GEMM        v, gv, W_v
    PUSH        stk_v, v, 1

    ; decay = exp(-exp(W2d tanh(W1d (u + d*xw)) + w0))
    EWMUL       dtimesx, d, xw
    EWADD       g32, u, dtimesx
    PUSH        stk_gpw, g32, 1
    GEMM        gdpre, g32, W1d
    PUSH        stk_gdpre, gdpre, 1
    COPY        gdact, gdpre
    ACT         gdact, gdact, tanh
    PUSH        stk_gdact, gdact, 1
    GEMM        om, gdact, W2d
    EWADD       om, om, w0
    EXP         expom, om
    PUSH        stk_expom, expom, 1
    NEG         expom, expom
    EXP         decay, expom
    PUSH        stk_decay, decay, 1

    ; S_t = S_{t-1} * decay + v outer k   (decay scales the row index i)
    TRANSPOSE   decayCol, decay
    EWMUL       st_S, st_S, decayCol
    OUTER       st_S, v, k
    PUSH        stk_Scur, st_S, 1

    ; o = LN_t(S r) ; keep S r for the LN_t backward
    GEMM        oCol, st_S, r
    TRANSPOSE   oRow, oCol
    COPY        sr, oRow
    PUSH        stk_sr_t, sr, 1
    LN          oRow, oRow, ln_t_g, ln_t_b
    PUSH        stk_oRow, oRow, 1

    ; h_t = h_{t-1} + W_o o
    GEMM        woCol, W_o, oRow
    TRANSPOSE   hpCol, st_hprev
    EWADD       hCol, hpCol, woCol
    TRANSPOSE   h, hCol
    COPY        st_hprev, h
    PUSH        stk_h, h, 1

    ; logits = LN_out(h) E^T
    LN          hNorm, h, ln_out_g, ln_out_b
    PUSH        stk_hNorm, hNorm, 1
    GEMM        logits1, hNorm, E

    ; ================================================================
    ;  BACKWARD: step 1 down to 0
    ;  dh and dS are cross-step accumulators: on entry to step t they
    ;  already hold the contribution arriving from step t+1.
    ; ================================================================
    ZERO        dS
    ZERO        dh

    ; only the final step's CE is surfaced (vm.loss holds the last one)

    ; ---------------- BACKWARD step 1 ----------------
    CE_BWD      logits1, dlogits, y1

    ; logits = LN_out(h) E^T
    POP         hNorm, stk_hNorm, 1
    GEMM_BWD_W  g_E, dlogits, hNorm
    GEMM_BWD_X  dhNorm, dlogits, E
    POP         h_t, stk_h, 1
    LN_BWD      dhAdd, dhNorm, h_t, ln_out_g
    EWADD       dh, dh, dhAdd        ; dh = total dh_t

    ; h_t = h_{t-1} + W_o o  (residual: dh flows straight to h_{t-1})
    ;
    ; GEMM_BWD_X gives dx[M,K] = dy[M,N] . W[N,K], with (M,N) taken from
    ; dy and K from W's columns. Feeding dy = dh as a ROW [1,H] and
    ; W = W_o[H,D] therefore yields do[1,D] -- exactly W_o^T dh.
    ; (Passing dh as a COLUMN [H,1] instead makes M=H,N=1 and asks the
    ;  kernel for a [H,D] result, which overruns do's buffer.)
    POP         oRow, stk_oRow, 1
    GEMM_BWD_W  g_W_o, dh, oRow
    GEMM_BWD_X  doRow, dh, W_o

    ; o = LN_t(sr)
    POP         sr_t, stk_sr_t, 1
    LN_BWD      dlnoRow, doRow, sr_t, ln_t_g

    ; sr = S_t r:  dS += d(sr) outer r ;  dr = d(sr) . S_t^T
    ;
    ; dS[i,j] = d(sr)[i] * r[j]      -> OUTER (which is += , so it stacks
    ;                                   onto any dS arriving from step t+1)
    ; dr[j]   = sum_i d(sr)[i]*S_t[i,j]
    ;         = d(sr)[1,D] . S_t[D,D]^T   -> GEMM NT: A=dlnoRow, B=S_t
    ;           (NT gives C[M,N] = A[M,K] B[N,K]^T with N = rows(B) = D)
    POP         r_t, stk_r, 1
    POP         S_t, stk_Scur, 1
    TRANSPOSE   dlnoCol, dlnoRow
    OUTER       dS, dlnoCol, r_t
    TRANSPOSE   S_tT, S_t
    GEMM        drRow, dlnoRow, S_tT      ; dr = d(sr) . S_t^T

    ; S_t = S_prev * decay + v outer k
    ;
    ; (dv, dk) = OUTER_BWD(dS, v, k)
    ;
    ; Calling convention (P8, fixed): OUTER_BWD dv, ds, v, k [, dk]
    ;   the interpreter takes k from ins.dt and dk from ins.dt+1, so
    ;   k and dk MUST be adjacent slots in the order k, dk.
    ;   (Before the P8 fix the assembler never encoded dt for OUTER_BWD,
    ;   so dk/dv silently landed in slot 0/1 = st_S/st_hprev and the
    ;   k-gate gradient was identically zero.)
    ; dv is overwritten and dk accumulates; both are step-local here
    ; because v and k are recomputed every step, so we zero dk first.
    POP         v_t, stk_v, 1
    POP         k_t, stk_k, 1
    POP         decay_t, stk_decay, 1
    POP         S_prev, stk_Sprev, 1
    ZERO        dkAcc
    OUTER_BWD   dv, dS, v_t, k_t, dkAcc
    TRANSPOSE   decayCol, decay_t
    EWMUL       dSprev, dS, decayCol
    EWMUL       dSwork, dS, S_prev
    ; ddecay[i] = sum_j dS[i,j]*S_prev[i,j]  (sum over the COLUMN index)
    ; SUM reduces the LAST dimension, so feed dSwork directly. Inserting a
    ; TRANSPOSE here sums over i instead and silently yields a wrong but
    ; plausible per-channel decay gradient.
    SUM         ddecay, dSwork

    ; decay = exp(-exp(w))
    ;   let e = exp(w);  decay = exp(-e)
    ;   d(decay)/dw = exp(-e) * (-1) * de/dw = -decay * exp(w)
    ; The MINUS is easy to drop: the forward has TWO nested exps, and the
    ; inner one contributes -1 to the chain. Forgetting it flips the sign
    ; of every gradient that flows through decay.
    ;   dom = -(ddecay * decay) * exp(w)
    POP         expom_t, stk_expom, 1
    EWMUL       ddom, ddecay, decay_t
    EWMUL       ddom, ddom, expom_t
    NEG         dom, ddom

    ; w = W2d gdact + w0
    POP         gdact_t, stk_gdact, 1
    GEMM_BWD_W  g_W2d, dom, gdact_t
    BIAS_BWD    g_w0, dom
    GEMM_BWD_X  dgdact, dom, W2d      ; dgdact[1,32] = dom . W2d

    ; gdact = tanh(gdpre)
    POP         gdpre_t, stk_gdpre, 1
    ACT_BWD     dgdpre, dgdact, gdpre_t, tanh

    ; gdpre = W1d gpw , gpw = u + d*xw
    POP         gpw_t, stk_gpw, 1
    GEMM_BWD_W  g_W1d, dgdpre, gpw_t
    GEMM_BWD_X  dg32w, dgdpre, W1d    ; dg32w[1,16] = dgdpre . W1d
    POP         d_t, stk_d, 1
    EWMUL       tmpXw, dg32w, d_t
    BIAS_BWD    g_xw, tmpXw
    ZERO        dU
    EWADD       dU, dU, dg32w
    ZERO        dDtot
    EWMUL       tmpDw, dg32w, xw
    EWADD       dDtot, dDtot, tmpDw

    ; gate r: r = sigmoid(W_r (u + d*xr))
    POP         rpre_t, stk_rpre, 1
    ACT_BWD     drpre, drRow, rpre_t, sigmoid
    POP         gpr_t, stk_gpr, 1
    GEMM_BWD_W  g_W_r, drpre, gpr_t
    GEMM_BWD_X  dgr, drpre, W_r      ; dgr[1,16] = drpre . W_r
    EWMUL       tmpXr, dgr, d_t
    BIAS_BWD    g_xr, tmpXr
    EWMUL       tmpDr, dgr, xr
    EWADD       dDtot, dDtot, tmpDr
    EWADD       dU, dU, dgr

    ; gate k: k = W_k (u + d*xk)
    POP         gpk_t, stk_gpk, 1
    GEMM_BWD_W  g_W_k, dkAcc, gpk_t
    GEMM_BWD_X  dgk, dkAcc, W_k      ; dgk[1,16] = dkAcc . W_k
    EWMUL       tmpXk, dgk, d_t
    BIAS_BWD    g_xk, tmpXk
    EWMUL       tmpDk, dgk, xk
    EWADD       dDtot, dDtot, tmpDk
    EWADD       dU, dU, dgk

    ; gate v: v = W_v (u + d*xv)
    POP         gpv_t, stk_gpv, 1
    GEMM_BWD_W  g_W_v, dv, gpv_t
    GEMM_BWD_X  dgv, dv, W_v         ; dgv[1,16] = dv . W_v
    EWMUL       tmpXv, dgv, d_t
    BIAS_BWD    g_xv, tmpXv
    EWMUL       tmpDv, dgv, xv
    EWADD       dDtot, dDtot, tmpDv
    EWADD       dU, dU, dgv

    ; u = LN_1(x) , d = h_{t-1} - u
    ; du_total = dU - dDtot   (d is subtracted from u)
    NEG         dDneg, dDtot
    EWADD       dUtot, dU, dDneg
    POP         x_t, stk_xt, 1
    LN_BWD      dxln, dUtot, x_t, ln1_g
    ; dh passed to step t-1: residual dh plus the d-branch contribution
    EWADD       dh, dh, dDtot
    COPY        dS, dSprev

    ; ---------------- BACKWARD step 0 ----------------
    CE_BWD      logits0, dlogits, y0

    ; logits = LN_out(h) E^T
    POP         hNorm, stk_hNorm, 0
    GEMM_BWD_W  g_E, dlogits, hNorm
    GEMM_BWD_X  dhNorm, dlogits, E
    POP         h_t, stk_h, 0
    LN_BWD      dhAdd, dhNorm, h_t, ln_out_g
    EWADD       dh, dh, dhAdd        ; dh = total dh_t

    ; h_t = h_{t-1} + W_o o  (residual: dh flows straight to h_{t-1})
    ;
    ; GEMM_BWD_X gives dx[M,K] = dy[M,N] . W[N,K], with (M,N) taken from
    ; dy and K from W's columns. Feeding dy = dh as a ROW [1,H] and
    ; W = W_o[H,D] therefore yields do[1,D] -- exactly W_o^T dh.
    ; (Passing dh as a COLUMN [H,1] instead makes M=H,N=1 and asks the
    ;  kernel for a [H,D] result, which overruns do's buffer.)
    POP         oRow, stk_oRow, 0
    GEMM_BWD_W  g_W_o, dh, oRow
    GEMM_BWD_X  doRow, dh, W_o

    ; o = LN_t(sr)
    POP         sr_t, stk_sr_t, 0
    LN_BWD      dlnoRow, doRow, sr_t, ln_t_g

    ; sr = S_t r:  dS += d(sr) outer r ;  dr = d(sr) . S_t^T
    ;
    ; dS[i,j] = d(sr)[i] * r[j]      -> OUTER (which is += , so it stacks
    ;                                   onto any dS arriving from step t+1)
    ; dr[j]   = sum_i d(sr)[i]*S_t[i,j]
    ;         = d(sr)[1,D] . S_t[D,D]^T   -> GEMM NT: A=dlnoRow, B=S_t
    ;           (NT gives C[M,N] = A[M,K] B[N,K]^T with N = rows(B) = D)
    POP         r_t, stk_r, 0
    POP         S_t, stk_Scur, 0
    TRANSPOSE   dlnoCol, dlnoRow
    OUTER       dS, dlnoCol, r_t
    TRANSPOSE   S_tT, S_t
    GEMM        drRow, dlnoRow, S_tT      ; dr = d(sr) . S_t^T

    ; S_t = S_prev * decay + v outer k
    ;
    ; (dv, dk) = OUTER_BWD(dS, v, k)
    ;
    ; Calling convention (P8, fixed): OUTER_BWD dv, ds, v, k [, dk]
    ;   the interpreter takes k from ins.dt and dk from ins.dt+1, so
    ;   k and dk MUST be adjacent slots in the order k, dk.
    ;   (Before the P8 fix the assembler never encoded dt for OUTER_BWD,
    ;   so dk/dv silently landed in slot 0/1 = st_S/st_hprev and the
    ;   k-gate gradient was identically zero.)
    ; dv is overwritten and dk accumulates; both are step-local here
    ; because v and k are recomputed every step, so we zero dk first.
    POP         v_t, stk_v, 0
    POP         k_t, stk_k, 0
    POP         decay_t, stk_decay, 0
    POP         S_prev, stk_Sprev, 0
    ZERO        dkAcc
    OUTER_BWD   dv, dS, v_t, k_t, dkAcc
    TRANSPOSE   decayCol, decay_t
    EWMUL       dSprev, dS, decayCol
    EWMUL       dSwork, dS, S_prev
    ; ddecay[i] = sum_j dS[i,j]*S_prev[i,j]  (sum over the COLUMN index)
    ; SUM reduces the LAST dimension, so feed dSwork directly. Inserting a
    ; TRANSPOSE here sums over i instead and silently yields a wrong but
    ; plausible per-channel decay gradient.
    SUM         ddecay, dSwork

    ; decay = exp(-exp(w))
    ;   let e = exp(w);  decay = exp(-e)
    ;   d(decay)/dw = exp(-e) * (-1) * de/dw = -decay * exp(w)
    ; The MINUS is easy to drop: the forward has TWO nested exps, and the
    ; inner one contributes -1 to the chain. Forgetting it flips the sign
    ; of every gradient that flows through decay.
    ;   dom = -(ddecay * decay) * exp(w)
    POP         expom_t, stk_expom, 0
    EWMUL       ddom, ddecay, decay_t
    EWMUL       ddom, ddom, expom_t
    NEG         dom, ddom

    ; w = W2d gdact + w0
    POP         gdact_t, stk_gdact, 0
    GEMM_BWD_W  g_W2d, dom, gdact_t
    BIAS_BWD    g_w0, dom
    GEMM_BWD_X  dgdact, dom, W2d      ; dgdact[1,32] = dom . W2d

    ; gdact = tanh(gdpre)
    POP         gdpre_t, stk_gdpre, 0
    ACT_BWD     dgdpre, dgdact, gdpre_t, tanh

    ; gdpre = W1d gpw , gpw = u + d*xw
    POP         gpw_t, stk_gpw, 0
    GEMM_BWD_W  g_W1d, dgdpre, gpw_t
    GEMM_BWD_X  dg32w, dgdpre, W1d    ; dg32w[1,16] = dgdpre . W1d
    POP         d_t, stk_d, 0
    EWMUL       tmpXw, dg32w, d_t
    BIAS_BWD    g_xw, tmpXw
    ZERO        dU
    EWADD       dU, dU, dg32w
    ZERO        dDtot
    EWMUL       tmpDw, dg32w, xw
    EWADD       dDtot, dDtot, tmpDw

    ; gate r: r = sigmoid(W_r (u + d*xr))
    POP         rpre_t, stk_rpre, 0
    ACT_BWD     drpre, drRow, rpre_t, sigmoid
    POP         gpr_t, stk_gpr, 0
    GEMM_BWD_W  g_W_r, drpre, gpr_t
    GEMM_BWD_X  dgr, drpre, W_r      ; dgr[1,16] = drpre . W_r
    EWMUL       tmpXr, dgr, d_t
    BIAS_BWD    g_xr, tmpXr
    EWMUL       tmpDr, dgr, xr
    EWADD       dDtot, dDtot, tmpDr
    EWADD       dU, dU, dgr

    ; gate k: k = W_k (u + d*xk)
    POP         gpk_t, stk_gpk, 0
    GEMM_BWD_W  g_W_k, dkAcc, gpk_t
    GEMM_BWD_X  dgk, dkAcc, W_k      ; dgk[1,16] = dkAcc . W_k
    EWMUL       tmpXk, dgk, d_t
    BIAS_BWD    g_xk, tmpXk
    EWMUL       tmpDk, dgk, xk
    EWADD       dDtot, dDtot, tmpDk
    EWADD       dU, dU, dgk

    ; gate v: v = W_v (u + d*xv)
    POP         gpv_t, stk_gpv, 0
    GEMM_BWD_W  g_W_v, dv, gpv_t
    GEMM_BWD_X  dgv, dv, W_v         ; dgv[1,16] = dv . W_v
    EWMUL       tmpXv, dgv, d_t
    BIAS_BWD    g_xv, tmpXv
    EWMUL       tmpDv, dgv, xv
    EWADD       dDtot, dDtot, tmpDv
    EWADD       dU, dU, dgv

    ; u = LN_1(x) , d = h_{t-1} - u
    ; du_total = dU - dDtot   (d is subtracted from u)
    NEG         dDneg, dDtot
    EWADD       dUtot, dU, dDneg
    POP         x_t, stk_xt, 0
    LN_BWD      dxln, dUtot, x_t, ln1_g
    ; dh passed to step t-1: residual dh plus the d-branch contribution
    EWADD       dh, dh, dDtot
    COPY        dS, dSprev

    ; ================================================================
    ;  gradient clipping + AdamW update
    ;  hparams = [lr, b1, b2, eps, wd]
    ; ================================================================
    CLIP_GRAD   g_W_r, clip_norm
    CLIP_GRAD   g_W_k, clip_norm
    CLIP_GRAD   g_W_v, clip_norm
    CLIP_GRAD   g_W_o, clip_norm
    CLIP_GRAD   g_W1d, clip_norm
    CLIP_GRAD   g_W2d, clip_norm
    CLIP_GRAD   g_w0, clip_norm
    CLIP_GRAD   g_xr, clip_norm
    CLIP_GRAD   g_xk, clip_norm
    CLIP_GRAD   g_xv, clip_norm
    CLIP_GRAD   g_xw, clip_norm
    CLIP_GRAD   g_ln1_g, clip_norm
    CLIP_GRAD   g_ln1_b, clip_norm
    CLIP_GRAD   g_ln_t_g, clip_norm
    CLIP_GRAD   g_ln_t_b, clip_norm
    CLIP_GRAD   g_ln_out_g, clip_norm
    CLIP_GRAD   g_ln_out_b, clip_norm
    CLIP_GRAD   g_E, clip_norm

    ADAMW       W_r, g_W_r, hparams
    ADAMW       W_k, g_W_k, hparams
    ADAMW       W_v, g_W_v, hparams
    ADAMW       W_o, g_W_o, hparams
    ADAMW       W1d, g_W1d, hparams
    ADAMW       W2d, g_W2d, hparams
    ADAMW       w0, g_w0, hparams
    ADAMW       xr, g_xr, hparams
    ADAMW       xk, g_xk, hparams
    ADAMW       xv, g_xv, hparams
    ADAMW       xw, g_xw, hparams
    ADAMW       ln1_g, g_ln1_g, hparams
    ADAMW       ln1_b, g_ln1_b, hparams
    ADAMW       ln_t_g, g_ln_t_g, hparams
    ADAMW       ln_t_b, g_ln_t_b, hparams
    ADAMW       ln_out_g, g_ln_out_g, hparams
    ADAMW       ln_out_b, g_ln_out_b, hparams
    ADAMW       E, g_E, hparams

    ; Surface the per-step logits so the driver can compute the mean CE over
    ; all T steps. NOTE: CE_BWD writes the engine's vm.loss, and because the
    ; backward pass runs from step T-1 down to 0, vm.loss ends up holding the
    ; CE of **step 0**, not the last step. So the driver recomputes the loss
    ; from these logits instead of trusting vm.loss.
    COPY        loss_out0, logits0
    COPY        loss_out1, logits1
    HALT
