SHAPE off, 5, 1
SHAPE srci, 24, 1
SHAPE wv, 24, 1
SHAPE xv, 6, 1
SHAPE str, 24, 1
SHAPE kk, 1, 1
SHAPE sel, 24, 2
SHAPE y, 5, 1
    COPY off, offc
    COPY srci, srcc
    COPY wv, wvc
    COPY xv, xvc
    COPY str, strc
    COPY kk, kc
    TOPK_BY_STRENGTH sel, str, kk
    SPARSE_MATVEC y, off, srci, wv, xv, nnz
    HALT
