; MiniCPM5-1B full forward (generated by tools/p12_build_minicpm.py)
; S=4 layers=24 hidden=1536 heads=16 kv_heads=2 head_dim=128 inter=4608 vocab=130560
;
; Weights are bf16 and stay bf16: the engine widens them inside the GEMM
; (P12). Widening to f32 on disk would double 2.16 GB to 4.32 GB.
;
; Shapes are declared explicitly because the assembler infers only from
; instruction use, and a wrong width here is a silent misread.

; ---- shapes (activations) ----
SHAPE h,      4, 1536
SHAPE h2,     4, 1536
SHAPE xn,     4, 1536
SHAPE q,      4, 2048
SHAPE k,      4, 256
SHAPE v,      4, 256
SHAPE qh,     4, 128
SHAPE kh,     4, 128
SHAPE vh,     4, 128
SHAPE qrot,   4, 128
SHAPE krot,   4, 128
SHAPE sc,     4, 4
SHAPE ctx,    4, 128
SHAPE att,    4, 2048
SHAPE oproj,  4, 1536
SHAPE gate,   4, 4608
SHAPE up,     4, 4608
SHAPE acts,   4, 4608
SHAPE down,   4, 1536
SHAPE tail,   4, 8
SHAPE eps1,   1, 1
SHAPE theta1, 1, 1
SHAPE scale1, 1, 1

; ---- embedding lookup: h = embed[tokens]  (P13 task A) ----
; THE POINT OF THIS MODE: the program carries NO prompt data.
; Token ids are read from `tokens.bin` by the runtime into the
; `st_tok` state slot, then EMB widens one row per token.
; ONE .vmb therefore serves ANY prompt -- changing the prompt is a
; 16-byte file write instead of a 1.76 GB reassembly (~106 s).
;
; `st_tok` is a state slot (the `st_` prefix); state is engine-owned
; and persists, and the runtime fills it before run().
;
; Its shape MUST be declared: an undeclared slot has capacity 0, and
; the runtime then hard-fails with 'tokens.bin is longer than the
; st_tok slot' (measured -- that guard is what caught this). [1,S]
; because the runtime fills it with S token ids, one per element.
SHAPE st_tok, 1, 4
;
; EMB reads its row index from a SINGLE scalar slot, so one lookup is
; needed per token position. Rows are then stacked with CONCAT, which
; concatenates along COLUMNS -- so we transpose the problem: look up
; the token's row as [1,H], and build h by concatenating the S rows
; side by side into [1, S*H], then RESHAPE-equivalent via SHAPE.
; Simpler and exact: build a [S,H] h by concatenating single-row
; slices, so the intermediate is [1,H] and CONCAT gives [1,S*H].
; That layout is (token-major), i.e. element (i, j) sits at i*H + j,
; which IS row-major [S,H]. So h = the concatenated buffer.
;   row 0 = embed[tok[0]]
SLICE tok0, st_tok, 0, 1
SHAPE e0, 1, 1536
EMB e0, embed, tok0
;   row 1 = embed[tok[1]]
SLICE tok1, st_tok, 1, 1
SHAPE e1, 1, 1536
EMB e1, embed, tok1
;   row 2 = embed[tok[2]]
SLICE tok2, st_tok, 2, 1
SHAPE e2, 1, 1536
EMB e2, embed, tok2
;   row 3 = embed[tok[3]]
SLICE tok3, st_tok, 3, 1
SHAPE e3, 1, 1536
EMB e3, embed, tok3
SHAPE hcat0, 1, 1536
COPY hcat0, e0
SHAPE hcat1, 1, 3072
CONCAT hcat1, hcat0, e1
SHAPE hcat2, 1, 4608
CONCAT hcat2, hcat1, e2
SHAPE hcat3, 1, 6144
CONCAT hcat3, hcat2, e3
SHAPE hflat, 4, 1536
COPY hflat, hcat3
COPY h, hflat

; ================= layer 0 =================
RMSNORM xn, h, L0_in_ln, eps1
GEMM q, xn, L0_q
GEMM k, xn, L0_k
GEMM v, xn, L0_v
SLICE qh, q, 0, 128
SLICE kh, k, 0, 128
SLICE vh, v, 0, 128
ROPE qrot, qh, theta1, 0
ROPE krot, kh, theta1, 0
