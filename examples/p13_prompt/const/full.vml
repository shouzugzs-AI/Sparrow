; MiniCPM5-1B full forward (generated by tools/p12_build_minicpm.py)
; S=4 layers=1 hidden=1536 heads=16 kv_heads=2 head_dim=128 inter=4608 vocab=130560
;
; Weights are bf16 and stay bf16: the engine widens them inside the GEMM
; (P12). Widening to f32 on disk would double 2.16 GB to 4.32 GB.
;
; Shapes are declared explicitly because the assembler infers only from
; instruction use, and a wrong width here is a silent misread.

; ---- shapes (activations) ----
SHAPE h,      4, 1536
SHAPE h2,     4, 1536
SHAPE xn,     4, 1536
SHAPE q,      4, 2048
SHAPE k,      4, 256
SHAPE v,      4, 256
SHAPE qh,     4, 128
SHAPE kh,     4, 128
SHAPE vh,     4, 128
SHAPE qrot,   4, 128
SHAPE krot,   4, 128
SHAPE sc,     4, 4
SHAPE ctx,    4, 128
SHAPE att,    4, 2048
SHAPE oproj,  4, 1536
SHAPE gate,   4, 4608
SHAPE up,     4, 4608
SHAPE acts,   4, 4608
SHAPE down,   4, 1536
SHAPE tail,   4, 8
SHAPE eps1,   1, 1
SHAPE theta1, 1, 1
SHAPE scale1, 1, 1

; ---- embedding lookup: h = embed[token] ----
; PRE-P13 PATH (kept for comparison / regression): the prompt rows are
; extracted HOST-SIDE and baked in as a constant, so every new prompt
; requires reassembling this whole .vmb.
COPY h, prompt_emb

; ================= layer 0 =================
RMSNORM xn, h, L0_in_ln, eps1
GEMM q, xn, L0_q
GEMM k, xn, L0_k
GEMM v, xn, L0_v
SLICE qh, q, 0, 128
SLICE kh, k, 0, 128
SLICE vh, v, 0, 128
ROPE qrot, qh, theta1, 0
ROPE krot, kh, theta1, 0
GEMM sc, qrot, krot
SCALE sc, sc, scale1
SOFTMAX sc, sc, causal
GEMM ctx, sc, vh, nn
WRITECOL att, ctx, 0, 128
SLICE qh, q, 128, 128
SLICE kh, k, 0, 128
SLICE vh, v, 0, 128
ROPE qrot, qh, theta1, 0
ROPE krot, kh, theta1, 0
GEMM sc, qrot, krot
SCALE sc, sc, scale1
SOFTMAX sc, sc, causal
GEMM ctx, sc, vh, nn
WRITECOL att, ctx, 128, 128
SLICE qh, q, 256, 128
SLICE kh, k, 0, 128
SLICE vh, v, 0, 128
ROPE qrot, qh, theta1, 0
ROPE krot, kh, theta1, 0
GEMM sc, qrot, krot
SCALE sc, sc, scale1
SOFTMAX sc, sc, causal
GEMM ctx, sc, vh, nn
WRITECOL att, ctx, 256, 128
SLICE qh, q, 384, 128
SLICE kh, k, 0, 128
SLICE vh, v, 0, 128
ROPE qrot, qh, theta1, 0
ROPE krot, kh, theta1, 0
GEMM sc, qrot, krot
SCALE sc, sc, scale1
SOFTMAX sc, sc, causal
GEMM ctx, sc, vh, nn
WRITECOL att, ctx, 384, 128
SLICE qh, q, 512, 128
SLICE kh, k, 0, 128
SLICE vh, v, 0, 128
ROPE qrot, qh, theta1, 0
ROPE krot, kh, theta1, 0
GEMM sc, qrot, krot
SCALE sc, sc, scale1
SOFTMAX sc, sc, causal
GEMM ctx, sc, vh, nn
WRITECOL att, ctx, 512, 128
SLICE qh, q, 640, 128
SLICE kh, k, 0, 128
SLICE vh, v, 0, 128
ROPE qrot, qh, theta1, 0
ROPE krot, kh, theta1, 0
GEMM sc, qrot, krot
SCALE sc, sc, scale1
SOFTMAX sc, sc, causal
GEMM ctx, sc, vh, nn
WRITECOL att, ctx, 640, 128
SLICE qh, q, 768, 128
SLICE kh, k, 0, 128
SLICE vh, v, 0, 128
ROPE qrot, qh, theta1, 0
ROPE krot, kh, theta1, 0
GEMM sc, qrot, krot
SCALE sc, sc, scale1
SOFTMAX sc, sc, causal
GEMM ctx, sc, vh, nn
WRITECOL att, ctx, 768, 128
SLICE qh, q, 896, 128
SLICE kh, k, 0, 128
SLICE vh, v, 0, 128
ROPE qrot, qh, theta1, 0
ROPE krot, kh, theta1, 0
GEMM sc, qrot, krot
SCALE sc, sc, scale1
SOFTMAX sc, sc, causal
GEMM ctx, sc, vh, nn
WRITECOL att, ctx, 896, 128
SLICE qh, q, 1024, 128
SLICE kh, k, 128, 128
SLICE vh, v, 128, 128
ROPE qrot, qh, theta1, 0
ROPE krot, kh, theta1, 0
GEMM sc, qrot, krot
SCALE sc, sc, scale1
SOFTMAX sc, sc, causal
GEMM ctx, sc, vh, nn
WRITECOL att, ctx, 1024, 128
SLICE qh, q, 1152, 128
SLICE kh, k, 128, 128
SLICE vh, v, 128, 128
ROPE qrot, qh, theta1, 0
ROPE krot, kh, theta1, 0
GEMM sc, qrot, krot
SCALE sc, sc, scale1
SOFTMAX sc, sc, causal
GEMM ctx, sc, vh, nn
WRITECOL att, ctx, 1152, 128
SLICE qh, q, 1280, 128
SLICE kh, k, 128, 128
SLICE vh, v, 128, 128
ROPE qrot, qh, theta1, 0
ROPE krot, kh, theta1, 0
GEMM sc, qrot, krot
SCALE sc, sc, scale1
SOFTMAX sc, sc, causal
GEMM ctx, sc, vh, nn
WRITECOL att, ctx, 1280, 128
SLICE qh, q, 1408, 128
SLICE kh, k, 128, 128
SLICE vh, v, 128, 128
ROPE qrot, qh, theta1, 0
ROPE krot, kh, theta1, 0
GEMM sc, qrot, krot
SCALE sc, sc, scale1
SOFTMAX sc, sc, causal
GEMM ctx, sc, vh, nn
WRITECOL att, ctx, 1408, 128
SLICE qh, q, 1536, 128
SLICE kh, k, 128, 128
SLICE vh, v, 128, 128
ROPE qrot, qh, theta1, 0
ROPE krot, kh, theta1, 0
GEMM sc, qrot, krot
SCALE sc, sc, scale1
SOFTMAX sc, sc, causal
GEMM ctx, sc, vh, nn
WRITECOL att, ctx, 1536, 128
SLICE qh, q, 1664, 128
SLICE kh, k, 128, 128
SLICE vh, v, 128, 128
ROPE qrot, qh, theta1, 0
ROPE krot, kh, theta1, 0
GEMM sc, qrot, krot
SCALE sc, sc, scale1
SOFTMAX sc, sc, causal
GEMM ctx, sc, vh, nn
WRITECOL att, ctx, 1664, 128
SLICE qh, q, 1792, 128
SLICE kh, k, 128, 128
SLICE vh, v, 128, 128
ROPE qrot, qh, theta1, 0
ROPE krot, kh, theta1, 0
GEMM sc, qrot, krot
SCALE sc, sc, scale1
SOFTMAX sc, sc, causal
GEMM ctx, sc, vh, nn
WRITECOL att, ctx, 1792, 128
SLICE qh, q, 1920, 128
SLICE kh, k, 128, 128
SLICE vh, v, 128, 128
ROPE qrot, qh, theta1, 0
ROPE krot, kh, theta1, 0
GEMM sc, qrot, krot
SCALE sc, sc, scale1
SOFTMAX sc, sc, causal
GEMM ctx, sc, vh, nn
WRITECOL att, ctx, 1920, 128
GEMM oproj, att, L0_o
EWADD h2, h, oproj
RMSNORM xn, h2, L0_post_ln, eps1
GEMM gate, xn, L0_gate
GEMM up, xn, L0_up
ACT acts, gate, silu
EWMUL acts, acts, up
GEMM down, acts, L0_down
EWADD h, h2, down

; ---- final norm ----
RMSNORM xn, h, final_norm, eps1
PRINT xn

HALT
