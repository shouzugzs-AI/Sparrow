; P8 member F: Transformer training loop (T=4 D=8 NH=1 HD=8 F=16 V=8)
; Forward math follows examples/attn/block.vml; backward + AdamW are new here.
; Generated by examples/attn/train/gen_vml.py -- do not hand-edit.
;
; Layout decisions:
;   GEMM default is NT: C[M,N] = A[M,K]*B[N,K]^T, output width N = B.rows.
;   Attention y = att*V is naturally NN.  P7 fixed an nn bug (under NN the
;   width must come from B.cols), and block.vml only ever exercised it on a
;   square vh.  Here T=4 and HD=8 differ, so we take the task's advice and
;   use TRANSPOSE + default NT instead -- never touching nn:
;       Vt[HD,T] = TRANSPOSE(V)
;       y[M,HD]  = att[M,T] * Vt[HD,T]^T        <- plain NT
;   Backward mirrors it: datt = dy*V, dVt += datt^T*dy; shapes line up.
;
;   LN_BWD takes dg as its 4th operand and expects db in the slot right
;   after it (contract 2.2 + asm/src/main.rs), so dln*_g / dln*_b must be
;   declared as an adjacent pair with nothing in between.

    ; ===================== forward =====================
    ; --- slot-table ordering (LN_BWD addressing) ---
    ; LN_BWD dx, dy, x, <gslot>  reads gamma = slot[gslot] and writes
    ;   dgamma -> slot[gslot+1],  dbeta -> slot[gslot+2],
    ; addressing both by SLOT NUMBER.  The assembler hands out slot
    ; numbers in first-mention order, so the three names must be first
    ; mentioned consecutively, in that order.
    ; SHAPE is a load-time meta instruction (zero runtime cost, and
    ; force_shape skips Const slots), so it is a safe way to pin the
    ; numbering without touching any data.
    SHAPE       ln1_g, 1, 8
    SHAPE       g_ln1_g, 1, 8
    SHAPE       g_ln1_b, 1, 8
    SHAPE       ln2_g, 1, 8
    SHAPE       g_ln2_g, 1, 8
    SHAPE       g_ln2_b, 1, 8
    SHAPE       lnf_g, 1, 8
    SHAPE       g_lnf_g, 1, 8
    SHAPE       g_lnf_b, 1, 8

    SHAPE       x,        4, 8
    ; x = tok_emb + pos -- per-position EMB lookup so E gets a gradient.
    ; CONCAT joins along COLUMNS, so stacking rows needs a transpose each:
    ;   row r:  e_r[1,D] -> TRANSPOSE -> [D,1]  (a column)
    ;   CONCAT the columns -> [D,T] -> TRANSPOSE -> [T,D]
    SHAPE       e0, 1, 8
    EMB         e0, E, tokr0
    SHAPE       e0t, 8, 1
    TRANSPOSE   e0t, e0
    SHAPE       e1, 1, 8
    EMB         e1, E, tokr1
    SHAPE       e1t, 8, 1
    TRANSPOSE   e1t, e1
    SHAPE       e2, 1, 8
    EMB         e2, E, tokr2
    SHAPE       e2t, 8, 1
    TRANSPOSE   e2t, e2
    SHAPE       e3, 1, 8
    EMB         e3, E, tokr3
    SHAPE       e3t, 8, 1
    TRANSPOSE   e3t, e3
    SHAPE       embT01, 8, 2
    CONCAT      embT01, e0t, e1t
    SHAPE       embT23, 8, 2
    CONCAT      embT23, e2t, e3t
    SHAPE       embT, 8, 4
    CONCAT      embT, embT01, embT23
    SHAPE       emb, 4, 8
    TRANSPOSE   emb, embT
    COPY        x, emb
    EWADD       x, x, pos
    COPY        x0, x                   ; snapshot after embedding (LN1 bwd)

    ; ---- multi-head attention (NH=1, so one head) ----
    LN          xd, x, ln1_g, ln1_b
    GEMM        qkv, xd, Wqkv           ; [4,24]
    BIAS        qkv, bqkv
    SLICE       qc, qkv, 0, 8
    SLICE       kc, qkv, 8, 8
    SLICE       vc, qkv, 16, 8
    GEMM        att, qc, kc             ; S = Q*K^T   [4,4]
    SCALE       att, att, inv_sqrt_hd
    SOFTMAX     att, att, causal
    TRANSPOSE   vt, vc                  ; [8,4]
    GEMM        y, att, vt              ; y[4,8] via NT

    ; ---- output projection + residual ----
    GEMM        proj, y, Wproj
    BIAS        proj, bproj
    COPY        x1, x                    ; residual bypass snapshot
    EWADD       x, x, proj

    ; ---- FFN ----
    LN          xh, x, ln2_g, ln2_b
    GEMM        hpre, xh, W1            ; [4,16]
    BIAS        hpre, b1
    ACT         h, hpre, relu
    GEMM        ff, h, W2
    BIAS        ff, b2
    COPY        x2, x                    ; residual bypass snapshot
    EWADD       x, x, ff

    ; ---- output head ----
    LN          xf, x, lnf_g, lnf_b
    GEMM        logits, xf, E           ; [4,8]

    ; ===================== backward =====================
    ; param grads accumulate in the grad region -> zero them each step
    ZERO        g_Wqkv
    ZERO        g_bqkv
    ZERO        g_Wproj
    ZERO        g_bproj
    ZERO        g_W1
    ZERO        g_b1
    ZERO        g_W2
    ZERO        g_b2
    ZERO        g_ln1_g
    ZERO        g_ln1_b
    ZERO        g_ln2_g
    ZERO        g_ln2_b
    ZERO        g_lnf_g
    ZERO        g_lnf_b
    ZERO        g_E
    ZERO        g_pos

    ; ---- per-position cross entropy ----
    ; OP_CE_BWD is single-sample: it flattens its logits operand and takes
    ; ONE scalar target.  So we run it once per position on a [1,V] row
    ; slice, and stitch the rows back together.
    ; Row r of logits -> [V,1]:  TRANSPOSE to [V,T] then SLICE column r.
    ; We keep dlogits in [V,T] layout and use WRITECOL to drop each
    ; position's gradient in as a SINGLE column (width 1 -- WRITECOL
    ; copies `src.cols` entries per row from column `off`, so the source
    ; must be exactly as wide as the slice it lands in).
    SHAPE       logitsT, 8, 4
    TRANSPOSE   logitsT, logits
    SHAPE       dlogitsT, 8, 4
    ZERO        dlogitsT
    SHAPE       lgT0, 8, 1
    SLICE       lgT0, logitsT, 0, 1
    SHAPE       dlT0, 8, 1
    CE_BWD      lgT0, dlT0, tgt0    ; loss of position 0 -> vm.loss
    WRITECOL    dlogitsT, dlT0, 0      ; dlogitsT[:,0] = grad of row 0
    SHAPE       lgT1, 8, 1
    SLICE       lgT1, logitsT, 1, 1
    SHAPE       dlT1, 8, 1
    CE_BWD      lgT1, dlT1, tgt1    ; loss of position 1 -> vm.loss
    WRITECOL    dlogitsT, dlT1, 1      ; dlogitsT[:,1] = grad of row 1
    SHAPE       lgT2, 8, 1
    SLICE       lgT2, logitsT, 2, 1
    SHAPE       dlT2, 8, 1
    CE_BWD      lgT2, dlT2, tgt2    ; loss of position 2 -> vm.loss
    WRITECOL    dlogitsT, dlT2, 2      ; dlogitsT[:,2] = grad of row 2
    SHAPE       lgT3, 8, 1
    SLICE       lgT3, logitsT, 3, 1
    SHAPE       dlT3, 8, 1
    CE_BWD      lgT3, dlT3, tgt3    ; loss of position 3 -> vm.loss
    WRITECOL    dlogitsT, dlT3, 3      ; dlogitsT[:,3] = grad of row 3
    ; NOTE: OP_CE_BWD overwrites vm.loss each call, so vm.loss holds the
    ; LAST position's CE.  The driver recomputes the T-position mean loss
    ; from `logits` itself so the reported curve uses one consistent
    ; definition (same loss whose gradient we backpropagate).
    SHAPE       dlogits, 4, 8
    TRANSPOSE   dlogits, dlogitsT
    ; torch's cross_entropy over [T,V] logits with [T] targets takes the
    ; MEAN, while our per-position CE_BWD produces the SUM.  Scale by 1/T
    ; so the analytic gradient is directly comparable to torch's.
    SHAPE       inv_t, 1, 1
    SCALE       dlogits, dlogits, inv_t

    ; ---- head backward: logits = xf*E^T ----
    GEMM_BWD_W  g_E, dlogits, xf         ; dE  += dlogits^T*xf
    SHAPE       dxf, 4, 8
    GEMM_BWD_X  dxf, dlogits, E          ; dxf = dlogits*E
    SHAPE       dx, 4, 8
    ; LN_BWD: 4 operands -> dx, dy, x, <gslot>
    ;   gamma = slot[gslot],  dgamma -> slot[gslot+1],  dbeta -> slot[gslot+2]
    ; The forward section pinned (lnf_g, g_lnf_g, g_lnf_b) to contiguous
    ; slot numbers, so naming lnf_g here lands the two grads correctly.
    LN_BWD      dx, dxf, x, lnf_g

    ; ---- FFN backward (residual: both paths carry gradient) ----
    GEMM_BWD_W  g_W2, dx, h
    BIAS_BWD    g_b2, dx
    SHAPE       dh, 4, 16
    GEMM_BWD_X  dh, dx, W2
    SHAPE       dhpre, 4, 16
    ACT_BWD     dhpre, dh, hpre, relu
    GEMM_BWD_W  g_W1, dhpre, xh
    BIAS_BWD    g_b1, dhpre
    SHAPE       dxh, 4, 8
    GEMM_BWD_X  dxh, dhpre, W1
    SHAPE       dx2, 4, 8
    LN_BWD      dx2, dxh, x2, ln2_g
    EWADD       dx, dx, dx2              ; residual grad adds back

    ; ---- attention backward ----
    GEMM_BWD_W  g_Wproj, dx, y
    BIAS_BWD    g_bproj, dx
    SHAPE       dy, 4, 8
    GEMM_BWD_X  dy, dx, Wproj

    ; datt[M,T] = dy[M,HD] * V[T,HD]^T
    ; GEMM_BWD_X cannot express this: its kernel indexes w[j][p] with
    ;   j < n = dy.cols and p < k = w.rows, so it needs w's row stride
    ;   to equal w.rows -- only true for a square w.  With T != HD a
    ;   [T,HD] or [HD,T] w reads out of bounds.
    ; So transpose the whole product and use GEMM_BWD_W:
    ;   datt^T[T,M] = V[T,HD] * dy[M,HD]^T
    ;   GEMM_BWD_W dW[N,K] += A[i,N]^T * X[i,K]  with
    ;     A = vt [HD,T]  ->  A[i,n] = V[n,i]
    ;     X = dyT[HD,M]  ->  X[i,k] = dy[k,i]
    ;   => dW[n,k] = sum_i V[n,i]*dy[k,i] = datt^T   OK
    SHAPE       dattT, 4, 4
    SHAPE       dyT, 8, 4
    SHAPE       datt, 4, 4
    ZERO        dattT
    TRANSPOSE   dyT, dy
    GEMM_BWD_W  dattT, vt, dyT
    TRANSPOSE   datt, dattT

    ; dV[T,HD] += att[M,T]^T * dy[M,HD]  -- GEMM_BWD_W (accumulate).
    ;   NOTE: the operand is **att**, not datt.  y = att*V^T means
    ;   y[i,n] = sum_j att[i,j]*V[j,n], so dV[j,n] = sum_i att[i,j]*dy[i,n]
    ;   = att^T * dy.  Using datt here is the classic attention-backward bug.
    SHAPE       dvc, 4, 8
    ZERO        dvc
    GEMM_BWD_W  dvc, att, dy

    ; att = softmax(S, causal) -> dS  (**must pass causal** or grad leaks)
    SHAPE       dS, 4, 4
    SOFTMAX_BWD dS, datt, att, causal
    SCALE       dS, dS, inv_sqrt_hd      ; S = QK^T/sqrt(hd)

    ; S = Q*K^T -> dQ = dS*K,  dK += dS^T*Q
    ; GEMM_BWD_X computes dx = dy * w with w treated as [N,K] and
    ;   k forced to w.rows -- so it can only express dy*w^T (= NT).
    ; dS*K is a plain NN product, so route dQ through GEMM_BWD_W:
    ;   GEMM_BWD_W dW[N,K] += dy[M,N]^T * x[M,K]
    ;   dy = dS^T, x = K  ->  dW[T,D] += dS * K                = dQ
    ;   dy = dS,   x = Q  ->  dW[T,D] += dS^T * Q              = dK
    ; Both accumulate, so zero the targets first.
    SHAPE       dq, 4, 8
    SHAPE       dk, 4, 8
    SHAPE       dSt, 4, 4
    ZERO        dq
    ZERO        dk
    TRANSPOSE   dSt, dS
    GEMM_BWD_W  dq, dSt, kc              ; dq += dS*kc
    GEMM_BWD_W  dk, dS, qc               ; dk += dS^T*qc

    ; stitch Q/K/V back into dqkv (column order must match forward: q|k|v)
    SHAPE       dqk, 4, 16
    CONCAT      dqk, dq, dk
    SHAPE       dqkv, 4, 24
    CONCAT      dqkv, dqk, dvc

    ; qkv = xd*Wqkv^T + bqkv
    GEMM_BWD_W  g_Wqkv, dqkv, xd
    BIAS_BWD    g_bqkv, dqkv
    SHAPE       dxd, 4, 8
    GEMM_BWD_X  dxd, dqkv, Wqkv
    SHAPE       dx1, 4, 8
    LN_BWD      dx1, dxd, x0, ln1_g
    EWADD       dx, dx, dx1              ; residual grad adds back

    ; ---- embedding backward ----
    ; x = emb + pos -> demb = dx, dpos = dx
    ; Row r of dx: TRANSPOSE to [D,T], SLICE out column r -> [D,1],
    ; TRANSPOSE back to [1,D].  The engine only has column slice, so a row
    ; slice costs two transposes.
    SHAPE       demb, 8, 8
    SHAPE       dpos, 4, 8
    ZERO        demb
    ZERO        dpos
    SHAPE       dxt, 8, 4
    TRANSPOSE   dxt, dx                  ; [D,T]
    SHAPE       dxtc0, 8, 1
    SLICE       dxtc0, dxt, 0, 1     ; row 0 of dx, standing up
    SHAPE       dxr0, 1, 8
    TRANSPOSE   dxr0, dxtc0          ; back to [1,D]
    EMB_BWD     demb, dxr0, tokr0    ; demb[tok[0]] += dx[0]
    SHAPE       dxtc1, 8, 1
    SLICE       dxtc1, dxt, 1, 1     ; row 1 of dx, standing up
    SHAPE       dxr1, 1, 8
    TRANSPOSE   dxr1, dxtc1          ; back to [1,D]
    EMB_BWD     demb, dxr1, tokr1    ; demb[tok[1]] += dx[1]
    SHAPE       dxtc2, 8, 1
    SLICE       dxtc2, dxt, 2, 1     ; row 2 of dx, standing up
    SHAPE       dxr2, 1, 8
    TRANSPOSE   dxr2, dxtc2          ; back to [1,D]
    EMB_BWD     demb, dxr2, tokr2    ; demb[tok[2]] += dx[2]
    SHAPE       dxtc3, 8, 1
    SLICE       dxtc3, dxt, 3, 1     ; row 3 of dx, standing up
    SHAPE       dxr3, 1, 8
    TRANSPOSE   dxr3, dxtc3          ; back to [1,D]
    EMB_BWD     demb, dxr3, tokr3    ; demb[tok[3]] += dx[3]
    EMB_BWD     dpos, dxr0, posr0    ; dpos[0] += dx[0]
    EMB_BWD     dpos, dxr1, posr1    ; dpos[1] += dx[1]
    EMB_BWD     dpos, dxr2, posr2    ; dpos[2] += dx[2]
    EMB_BWD     dpos, dxr3, posr3    ; dpos[3] += dx[3]
    ; fold the activation-slot gradients into the real grad region.
    ; `E` is used twice (output head AND token embedding table), so its
    ; two contributions must be summed: g_E already holds the head part
    ; from GEMM_BWD_W above, demb holds the embedding part.
    EWADD       g_E, g_E, demb
    EWADD       g_pos, g_pos, dpos

    ; ---- AdamW in place on the constant pool (no recompile, whitepaper 4.3) ----
    ADAMW       Wqkv, g_Wqkv, hparams
    ADAMW       bqkv, g_bqkv, hparams
    ADAMW       Wproj, g_Wproj, hparams
    ADAMW       bproj, g_bproj, hparams
    ADAMW       W1, g_W1, hparams
    ADAMW       b1, g_b1, hparams
    ADAMW       W2, g_W2, hparams
    ADAMW       b2, g_b2, hparams
    ADAMW       ln1_g, g_ln1_g, hparams
    ADAMW       ln1_b, g_ln1_b, hparams
    ADAMW       ln2_g, g_ln2_g, hparams
    ADAMW       ln2_b, g_ln2_b, hparams
    ADAMW       lnf_g, g_lnf_g, hparams
    ADAMW       lnf_b, g_lnf_b, hparams
    ADAMW       E, g_E, hparams
    ADAMW       pos, g_pos, hparams
    HALT
